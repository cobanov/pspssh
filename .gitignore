# Build output.
build/
out/
*.o
*.elf
*.prx
EBOOT.PBP
PARAM.SFO

# Sources fetched during the toolchain build, which have their own licences and
# their own repositories. third_party/ itself is committed — the font in it is
# needed to compile, and ignoring the whole directory meant a fresh clone did
# not build at all.
third_party/wolfssl/
third_party/wolfssh/

# Whatever SND0.AT3 was encoded from. The finished AT3 is committed because the
# build needs it; the multi-megabyte track it came from is not the repository's
# to carry, and is usually not ours to redistribute either.
assets/*.mp3
assets/*.wav
assets/*.flac
assets/*.m4a
assets/*.aiff

# macOS leaves these everywhere.
.DS_Store
